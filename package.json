{
  "name": "canvas-picker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/pick.d.ts",
      "default": "./lib/pick.js"
    },
    "./shapes": {
      "types": "./lib/shapes.d.ts",
      "default": "./lib/shapes.js"
    },
    "./drag": {
      "types": "./lib/drag.d.ts",
      "default": "./lib/drag.js"
    }
  },
  "files": ["lib"],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && tsc && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
