{
  "name": "@hyrfilm/canvas-picker",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:package": "vite build --config vite.package.config.ts && tsc -p tsconfig.package.json",
    "prepack": "npm run build:package"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Hit testing, pointer events, and dragging for shapes on a 2D canvas.",
  "keywords": [
    "canvas",
    "canvas2d",
    "hit-testing",
    "color-picking",
    "pointer-events",
    "drag",
    "offscreen-canvas"
  ],
  "homepage": "https://hyrfilm.github.io/canvas-picker/",
  "bugs": {
    "url": "https://github.com/hyrfilm/canvas-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyrfilm/canvas-picker.git"
  },
  "files": [
    "build/package"
  ],
  "types": "./build/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/package/index.d.ts",
      "import": "./build/package/index.js"
    },
    "./index-buffer": {
      "types": "./build/package/index-buffer.d.ts",
      "import": "./build/package/index-buffer.js"
    }
  }
}
